# ============================================
# envmgr 示例 .env 文件
# 使用方法: envmgr import examples/.env.example
# ============================================

# --- 数据库配置 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=dbadmin
DB_PASSWORD=change_this_to_strong_password

# --- API 配置 ---
API_BASE_URL=https://api.example.com/v1
API_KEY=sk-live-xxxxxxxxxxxxxxxxxxxxxxxxxx
API_SECRET=secret_key_here_please_change
AUTH_TOKEN=jwt_token_for_authentication

# --- 应用配置 ---
APP_NAME=MyApplication
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
APP_SECRET_KEY=generate_a_random_secret_here

# --- 缓存 / 消息队列 ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=optional_redis_password

# --- 对象存储 ---
S3_BUCKET=myapp-assets
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- 第三方 OAuth ---
OAUTH_CLIENT_ID=client_id_from_provider
OAUTH_CLIENT_SECRET=client_secret_from_provider
OAUTH_REDIRECT_URI=https://myapp.example.com/callback
